# КРАБ - пример файла настроек.
# Создавать .env вручную НЕ обязательно: ключ и прокси вводятся в программе
# (шестерёнка справа вверху), файл bin\.env появится сам.
# Чтобы задать дополнительные параметры - скопируйте этот файл в bin\.env и поправьте.

# Ключ API ИИ-роутера Selectel. Через интерфейс сохраняется зашифрованным (dpapi:...).
SELECTEL_API_KEY=

# Адрес и порт веб-интерфейса. HOST=0.0.0.0 открывает программу всей локальной сети -
# авторизации в интерфейсе нет, используйте только если понимаете риск.
HOST=127.0.0.1
PORT=38573

# Модель по умолчанию и лимит шагов агента на один запрос (1-60).
# Лимит итераций - сколько раз подряд модель может вызывать инструменты
# (чтение файлов, код и т.п.) в рамках одного запроса. Задаётся и в настройках программы.
#DEFAULT_MODEL=deepseek/deepseek-v4.1-flash
#MAX_ITERATIONS=30

# Рабочая папка с документами. По умолчанию - папка workspace в корне программы.
# Относительный путь отсчитывается от корня программы (не от bin).
#WORKSPACE_DIR=workspace

# Прокси и SSL (обычно задаются в интерфейсе)
#HTTPS_PROXY=http://proxy.corp.local:3128
#PROXY_USER=
#PROXY_PASSWORD=
# true | false | путь к корпоративному сертификату .pem/.crt
#SSL_VERIFY=true

# Останавливать программу, когда закрыто последнее окно интерфейса (по умолчанию true)
#STOP_ON_CLOSE=true

# Дневной лимит расходов в рублях (0 - без лимита). Задаётся и в настройках программы.
#DAILY_LIMIT_RUB=0

# Наибольший размер файла для кнопки "Прикрепить файл", МБ
#UPLOAD_MAX_MB=200

# Максимум тишины от модели, секунд: если дольше нет ни одного символа ответа,
# запрос прерывается с ошибкой "Модель молчит...". Для длинных рассуждений
# (deepseek-r1 и т.п.) увеличьте. Задаётся и в настройках программы.
STREAM_STALL_TIMEOUT=180

# Tesseract OCR. Не задано - используется bin\Tesseract-OCR\tesseract.exe из комплекта.
#TESSERACT_CMD=

# Адрес API (менять не нужно)
#SELECTEL_BASE_URL=https://api.selectel.ru/aig/v1
